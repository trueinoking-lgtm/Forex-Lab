  "advancement_gates": {
    "zero_leakage_failures": true,
    "deterministic_replay": true,
    "ohlc_validity_min": 0.999,
    "norm_close_mae_improvement_min_pct": 2.0,
    "pairs_improved_min": 3,
    "max_single_pair_contribution_pct": 50.0,
    "directional_accuracy_max_degradation_pp": 1.0,
    "max_forecast_failure_rate_pct": 1.0
  },
  "frozen_since": "2026-07-25"
