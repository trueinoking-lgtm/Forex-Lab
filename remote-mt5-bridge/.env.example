# ===== Remote MT5 Bridge (PC side — Windows) =====
# NEVER put these in Git. This .env lives only on the Windows PC.
# The VPS never sees these values — it only has REMOTE_MT5_BRIDGE_URL + TOKEN.

# Bearer token the VPS must present. Use a long random string.
REMOTE_MT5_BRIDGE_TOKEN=change-me-to-a-long-random-token

# MT5 demo account credentials (DEMO account only — never a live account).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Optional: override broker symbol naming, e.g. {"EURUSD":"EURUSDm","XAUUSD":"XAUUSD"}
MT5_SYMBOL_MAP=

# Bridge bind port (localhost only; exposed via tailscale serve).
BRIDGE_PORT=8787

# Placement gates (safe defaults).
DRY_RUN=true
DEMO_AUTOTRADE_ENABLED=false

# Local bridge kill switch (set true to block all orders from this PC).
BRIDGE_KILL_SWITCH=false
